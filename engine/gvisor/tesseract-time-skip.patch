+// Binary tesscoord is a Tesseract world coordinator (spike): it makes several
+// gVisor sandboxes share one clock. It skips time only when every sandbox is
+// idle and no bytes are in flight between them, and then moves every sandbox
+// forward by the same amount, to the earliest timer anywhere in the world.
+//
+// Usage: tesscoord -root DIR [-quantum 60s] [-grace 500us] [-ignore-inflight] ID...
+// Sandboxes must run with TESS_SKIP=coord.
+package main
+
+import (
+	"flag"
+	"fmt"
+	"os"
+	"time"
+
+	"gvisor.dev/gvisor/pkg/sentry/kernel"
+	"gvisor.dev/gvisor/pkg/urpc"
+	"gvisor.dev/gvisor/runsc/container"
+)
+
+var (
+	root           = flag.String("root", "", "runsc --root directory")
+	quantum        = flag.Duration("quantum", 0, "round skip targets up to a multiple of this")
+	grace          = flag.Duration("grace", 500*time.Microsecond, "idle time required in every sandbox")
+	poll           = flag.Duration("poll", 200*time.Microsecond, "poll interval")
+	ignoreInflight = flag.Bool("ignore-inflight", false, "skip even with bytes in flight (to show the hazard)")
+	statsEvery     = flag.Int("stats", 1000, "print a line every N skips")
+)
+
+func main() {
+	flag.Parse()
+	ids := flag.Args()
+	var conns []*urpc.Client
+	for _, id := range ids {
+		var c *container.Container
+		var err error
+		for i := 0; i < 100; i++ {
+			c, err = container.Load(*root, container.FullID{SandboxID: id, ContainerID: id}, container.LoadOpts{})
+			if err == nil {
+				break
+			}
+			time.Sleep(100 * time.Millisecond)
+		}
+		if err != nil {
+			fmt.Fprintf(os.Stderr, "load %s: %v\n", id, err)
+			os.Exit(1)
+		}
+		conn, err := c.Sandbox.Connect()
+		if err != nil {
+			fmt.Fprintf(os.Stderr, "connect %s: %v\n", id, err)
+			os.Exit(1)
+		}
+		conns = append(conns, conn)
+	}
+	states := make([]kernel.TessState, len(conns))
+	query := func() bool {
+		for i, c := range conns {
+			if err := c.Call("Tesseract.State", &struct{}{}, &states[i]); err != nil {
+				fmt.Fprintf(os.Stderr, "world ended: %v\n", err)
+				return false
+			}
+		}
+		return true
+	}
+	// Line every sandbox up on the same wall clock (the furthest ahead).
+	if !query() {
+		os.Exit(1)
+	}
+	var maxSkew int64
+	for _, s := range states {
+		maxSkew = max(maxSkew, s.SkewNs)
+	}
+	for i, c := range conns {
+		if d := maxSkew - states[i].SkewNs; d > 0 {
+			c.Call("Tesseract.Skip", &d, &struct{}{})
+		}
+	}
+	start := time.Now()
+	var skips, waitedInflight, exactSkips int64
+	var lastTx uint64
+	var skipped time.Duration
+	for {
+		time.Sleep(*poll)
+		if !query() {
+			break
+		}
+		idle, inflight, tx := true, int64(0), uint64(0)
+		next, hasNext := int64(1<<62), false
+		for _, s := range states {
+			if s.Running != 0 || s.IdleNs < int64(*grace) {
+				idle = false
+			}
+			inflight += int64(s.NetTx) - int64(s.NetRx)
+			tx += s.NetTx
+			if s.HasNext && s.UntilNextNs < next {
+				next, hasNext = s.UntilNextNs, true
+			}
+		}
+		if !idle || !hasNext || next < int64(time.Millisecond) {
+			continue // busy, nothing armed, or a timer is (nearly) due and its owner is about to wake
+		}
+		if inflight != 0 && !*ignoreInflight {
+			waitedInflight++
+			continue
+		}
+		d := next
+		// Adaptive quantum: if the services talked to each other since the
+		// last skip, a conversation may be under way (a request waiting on a
+		// reply, with a timeout). Then jump exactly to the next deadline so
+		// events keep their order. Only when the world is quiet do we round
+		// up and batch timers.
+		talking := tx != lastTx
+		lastTx = tx
+		if talking {
+			exactSkips++
+		}
+		if q := int64(*quantum); q > 0 && !talking {
+			target := states[0].MonoNs + d
+			target = (target + q - 1) / q * q
+			d = target - states[0].MonoNs
+		}
+		for _, c := range conns {
+			if err := c.Call("Tesseract.Skip", &d, &struct{}{}); err != nil {
+				fmt.Fprintf(os.Stderr, "world ended: %v\n", err)
+				os.Exit(0)
+			}
+		}
+		skips++
+		skipped += time.Duration(d)
+		if (skips-1)%int64(*statsEvery) == 0 {
+			for i, st := range states {
+				fmt.Printf("  sandbox %s: world time %v, skew %v, next timer in %v\n", ids[i], time.Unix(0, st.RealNs).UTC().Format(time.RFC3339), time.Duration(st.SkewNs).Round(time.Second), time.Duration(st.UntilNextNs))
+			}
+			fmt.Printf("tesscoord: %d skips, %v of world time skipped in %v real, %d waits for in-flight bytes, %d exact skips\n",
+				skips, skipped.Round(time.Second), time.Since(start).Round(time.Millisecond), waitedInflight, exactSkips)
+		}
+	}
+	fmt.Printf("tesscoord: done: %d skips, %v skipped in %v real, %d waits for in-flight bytes, %d exact skips\n",
+		skips, skipped.Round(time.Second), time.Since(start).Round(time.Millisecond), waitedInflight, exactSkips)
+}
