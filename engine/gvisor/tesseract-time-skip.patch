+package kernel
+
+// Tesseract time skipping (spike).
+//
+// While any task runs, time flows at real speed. When every task in the
+// sandbox has been blocked for a short grace period, the skipper moves all
+// clocks forward to the earliest armed timer deadline, so the program that
+// owns that timer wakes immediately. Time only ever moves forward.
+//
+// Enabled with TESS_SKIP=1 in runsc's environment. Optional:
+//   TESS_GRACE_US   idle time required before a skip (default 2000)
+//   TESS_QUANTUM_MS round skip targets up to a multiple of this (default 0)
+//   TESS_POLL_US    idle check interval (default 200)
+
+import (
+	"math"
+	"os"
+	"strconv"
+	"time"
+
+	"gvisor.dev/gvisor/pkg/atomicbitops"
+	"gvisor.dev/gvisor/pkg/log"
+	"gvisor.dev/gvisor/pkg/sentry/ktime"
+	sentrytime "gvisor.dev/gvisor/pkg/sentry/time"
+)
+
+// TessNetTx and TessNetRx count bytes written to and read from TCP sockets
+// that leave the sandbox (hostinet). Across a world, their difference is
+// the number of bytes in flight.
+var TessNetTx, TessNetRx atomicbitops.Uint64
+
+// tessIdleSince is the host monotonic time (ns) since which no task has
+// run, or 0 while some task is running. Maintained by the skipper goroutine.
+var tessIdleSince atomicbitops.Int64
+
+// TessState is what a sandbox reports to a world coordinator.
+type TessState struct {
+	Running     int64 // tasks running now
+	IdleNs      int64 // how long no task has run (0 if busy)
+	UntilNextNs int64 // time until the earliest armed timer
+	HasNext     bool  // whether any timer is armed
+	MonoNs      int64 // the sandbox's CLOCK_MONOTONIC
+	RealNs      int64 // the sandbox's CLOCK_REALTIME
+	SkewNs      int64 // total time skipped
+	NetTx       uint64
+	NetRx       uint64
+}
+
+// tessSkipGen counts skips, so idle tracking restarts after each one.
+var tessSkipGen atomicbitops.Int64
+
+// TessSkip moves every clock forward by d and restarts idle tracking.
+func (k *Kernel) TessSkip(d time.Duration) {
+	tessIdleSince.Store(0)
+	tessSkipGen.Add(1)
+	k.timekeeper.Skip(d)
+}
+
+// TessState samples this sandbox's state for a world coordinator.
+func (k *Kernel) TessState() TessState {
+	tk := k.timekeeper
+	var st TessState
+	st.Running = k.runningTasks.Load()
+	if since := tessIdleSince.Load(); since != 0 && st.Running == 0 {
+		st.IdleNs = time.Now().UnixNano() - since
+	}
+	d, ok := tk.UntilNextDeadline()
+	st.UntilNextNs, st.HasNext = int64(d), ok
+	st.MonoNs, _ = tk.GetTime(sentrytime.Monotonic)
+	st.RealNs, _ = tk.GetTime(sentrytime.Realtime)
+	st.SkewNs = int64(tk.Skewed())
+	st.NetTx, st.NetRx = TessNetTx.Load(), TessNetRx.Load()
+	return st
+}
+
+type trackedDeadline struct {
+	clock sentrytime.ClockID
+	next  ktime.Time
+}
+
+// trackDeadline records the setting of a SampledTimer on clock c.
+func (t *Timekeeper) trackDeadline(c sentrytime.ClockID, key *ktime.SampledTimer, s ktime.Setting) {
+	t.deadlineMu.Lock()
+	defer t.deadlineMu.Unlock()
+	if !s.Enabled {
+		delete(t.deadlines, key)
+		return
+	}
+	if t.deadlines == nil {
+		t.deadlines = make(map[*ktime.SampledTimer]trackedDeadline)
+	}
+	t.deadlines[key] = trackedDeadline{clock: c, next: s.Next}
+}
+
+// UntilNextDeadline returns how long until the earliest armed timer on any
+// timekeeper clock (including netstack timers) is due, and false if no timer
+// is armed.
+func (t *Timekeeper) UntilNextDeadline() (time.Duration, bool) {
+	best := int64(math.MaxInt64)
+	now := map[sentrytime.ClockID]int64{}
+	clockNow := func(c sentrytime.ClockID) int64 {
+		if v, ok := now[c]; ok {
+			return v
+		}
+		v, err := t.GetTime(c)
+		if err != nil {
+			panic(err)
+		}
+		now[c] = v
+		return v
+	}
+	t.deadlineMu.Lock()
+	for _, d := range t.deadlines {
+		if rem := d.next.Nanoseconds() - clockNow(d.clock); rem < best {
+			best = rem
+		}
+	}
+	t.deadlineMu.Unlock()
+	if target := t.afterFuncSchedulerTarget.Load(); target != math.MaxInt64 {
+		if rem := target - clockNow(sentrytime.Monotonic); rem < best {
+			best = rem
+		}
+	}
+	if best == math.MaxInt64 {
+		return 0, false
+	}
+	return time.Duration(best), true
+}
+
+// Skip moves every clock forward by d and makes all timers re-check their
+// deadlines.
+func (t *Timekeeper) Skip(d time.Duration) {
+	if d <= 0 {
+		return
+	}
+	t.skew.Add(int64(d))
+	t.updateMu.Lock()
+	if t.params != nil {
+		t.update(false)
+	}
+	t.updateMu.Unlock()
+	for _, c := range []*timekeeperClock{t.realtimeClock, t.monotonicClock, t.boottimeClock, t.monotonicRawClock} {
+		if c != nil {
+			c.queue.Notify(ktime.ClockEventSet)
+		}
+	}
+	select {
+	case t.afterFuncSchedulerWakeCh <- struct{}{}:
+	default:
+	}
+}
+
+// Skewed returns the total time skipped so far.
+func (t *Timekeeper) Skewed() time.Duration {
+	return time.Duration(t.skew.Load())
+}
+
+// worldClockFrozenAcrossRestore reports whether a restored sandbox should
+// resume at the exact world time it was saved at (TESS_SKIP=1 or
+// TESS_FREEZE=1), instead of Linux's default of letting wall time jump forward.
+func worldClockFrozenAcrossRestore() bool {
+	return os.Getenv("TESS_SKIP") == "1" || os.Getenv("TESS_FREEZE") == "1"
+}
+
+func envInt(name string, def int64) int64 {
+	if v, err := strconv.ParseInt(os.Getenv(name), 10, 64); err == nil {
+		return v
+	}
+	return def
+}
+
+// startTimeSkipper starts the time-skipping goroutine if TESS_SKIP=1, or
+// only the idle tracker if TESS_SKIP=coord (a world coordinator outside the
+// sandbox then decides when to skip, through the Tesseract control RPCs).
+func (k *Kernel) startTimeSkipper() {
+	mode := os.Getenv("TESS_SKIP")
+	if mode != "1" && mode != "coord" {
+		return
+	}
+	grace := time.Duration(envInt("TESS_GRACE_US", 2000)) * time.Microsecond
+	poll := time.Duration(envInt("TESS_POLL_US", 200)) * time.Microsecond
+	quantum := envInt("TESS_QUANTUM_MS", 0) * int64(time.Millisecond)
+	const minSkip = time.Millisecond
+	tk := k.timekeeper
+	log.Infof("tesseract: time skipping mode %q (grace %v, quantum %vns)", mode, grace, quantum)
+	go func() { // S/R-UNSAFE: spike only.
+		var idleSince time.Time
+		var skips int64
+		var lastTx uint64
+		var lastGen int64
+		for {
+			time.Sleep(poll)
+			if gen := tessSkipGen.Load(); gen != lastGen {
+				// Someone (a coordinator) skipped time: timers are firing
+				// and tasks are waking, so idleness must be observed anew.
+				lastGen = gen
+				idleSince = time.Time{}
+				tessIdleSince.Store(0)
+				continue
+			}
+			if k.runningTasks.Load() != 0 {
+				idleSince = time.Time{}
+				tessIdleSince.Store(0)
+				continue
+			}
+			if idleSince.IsZero() {
+				idleSince = time.Now()
+				tessIdleSince.Store(idleSince.UnixNano())
+				continue
+			}
+			if TessNetTx.Load() != TessNetRx.Load() {
+				continue // bytes in flight: someone is about to wake
+			}
+			if time.Since(idleSince) < grace {
+				continue
+			}
+			if mode == "coord" {
+				continue
+			}
+			d, ok := tk.UntilNextDeadline()
+			if !ok || d < minSkip {
+				continue // nothing armed, or a timer is (nearly) due: its owner is about to wake
+			}
+			// Adaptive quantum: exact skips while network traffic flows
+			// (see tesscoord), rounded-up batched skips when quiet.
+			tx := TessNetTx.Load()
+			talking := tx != lastTx
+			lastTx = tx
+			if quantum > 0 && !talking {
+				mono, _ := tk.GetTime(sentrytime.Monotonic)
+				target := mono + int64(d)
+				target = (target + quantum - 1) / quantum * quantum
+				d = time.Duration(target - mono)
+			}
+			if d < minSkip {
+				continue
+			}
+			k.TessSkip(d)
+			lastGen = tessSkipGen.Load()
+			skips++
+			if skips%1000 == 1 {
+				log.Infof("tesseract: skip #%d by %v, total skipped %v", skips, d, tk.Skewed())
+			}
+			idleSince = time.Time{}
+		}
+	}()
+}
