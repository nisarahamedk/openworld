+package boot
+
+import (
+	"time"
+
+	"gvisor.dev/gvisor/pkg/sentry/kernel"
+)
+
+// Tesseract exposes time-skipping control to a world coordinator (spike).
+type Tesseract struct {
+	k *kernel.Kernel
+}
+
+// State reports whether the sandbox is idle, its next timer deadline and its
+// in-flight byte counters.
+func (t *Tesseract) State(_ *struct{}, out *kernel.TessState) error {
+	*out = t.k.TessState()
+	return nil
+}
+
+// Skip moves every clock in the sandbox forward by *d nanoseconds.
+func (t *Tesseract) Skip(d *int64, _ *struct{}) error {
+	t.k.TessSkip(time.Duration(*d))
+	return nil
+}
