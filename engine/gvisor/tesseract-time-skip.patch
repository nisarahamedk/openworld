+// countTx and countRx keep Tesseract's in-flight byte accounting: bytes
+// written to TCP sockets minus bytes read from them, summed over every
+// sandbox in a world, is the number of bytes still in flight.
+func (s *Socket) countTx(n int64) {
+	if n > 0 && s.stype == linux.SOCK_STREAM && (s.family == linux.AF_INET || s.family == linux.AF_INET6) {
+		kernel.TessNetTx.Add(uint64(n))
+	}
+}
+
+func (s *Socket) countRx(n int64) {
+	if n > 0 && s.stype == linux.SOCK_STREAM && (s.family == linux.AF_INET || s.family == linux.AF_INET6) {
+		kernel.TessNetRx.Add(uint64(n))
+	}
+}
