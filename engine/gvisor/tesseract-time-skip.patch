+// DeadlineTracker is implemented by clocks that want to know the deadline of
+// every armed timer, so that a time-skipping controller can find the earliest
+// one. (Tesseract time skipping.)
+type DeadlineTracker interface {
+	// TrackDeadline records s as the current setting of timer key. A disabled
+	// setting removes the timer.
+	TrackDeadline(key *SampledTimer, s Setting)
+}
